# TIMEWISE Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel Environment Variables

# Optional External AI Provider ("gemini" | "openai")
# If omitted or left blank, TIMEWISE automatically uses its deterministic Rule-Based Study Engine fallback.
AI_PROVIDER=gemini

# Optional External AI API Key (Server-side only — never exposed to browser)
AI_API_KEY=

# Optional Model Override (e.g., gemini-2.5-flash or gpt-4o-mini)
AI_MODEL=gemini-2.5-flash
